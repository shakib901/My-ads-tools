<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>রিওয়ার্ড অ্যাপ</title>
    
    <!-- Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    
    <!-- Monetag SDK (আপনার zone দিয়ে) -->
    <script src="//libtl.com/sdk.js" data-zone="10539995" data-sdk="show_10539995"></script>
    
    <style>
        body {
            font-family: sans-serif;
            text-align: center;
            padding: 20px;
            background: var(--tg-theme-bg-color, #ffffff);
            color: var(--tg-theme-text-color, #000000);
            margin: 0;
            min-height: 100vh;
        }
        h1, h2 {
            color: var(--tg-theme-hint-color, #999999);
        }
        button {
            padding: 15px 30px;
            margin: 15px;
            font-size: 18px;
            background: var(--tg-theme-button-color, #0088cc);
            color: var(--tg-theme-button-text-color, #ffffff);
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }
        button:disabled {
            opacity: 0.6;
        }
        #points {
            font-size: 32px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <h1>স্বাগতম!</h1>
    <h2>রিওয়ার্ড মিনি অ্যাপ</h2>
    <p>বর্তমান পয়েন্ট: <span id="points">0</span></p>
    
    <button id="interstitialBtn">ইন্টারস্টিশিয়াল অ্যাড দেখে ১০০ পয়েন্ট নিন</button>
    <br>
    <button id="popupBtn">পপআপ অ্যাড খুলে ১০০ পয়েন্ট নিন</button>

    <script>
        // Telegram WebApp initialize
        Telegram.WebApp.ready();
        Telegram.WebApp.expand();

        // Points system
        let points = 0;
        const pointsDisplay = document.getElementById('points');

        function updatePoints() {
            pointsDisplay.textContent = points;
        }

        // Preload interstitial ad (better experience)
        if (typeof show_10539995 === 'function') {
            show_10539995({ type: 'preload' }).catch(() => {});
        }

        // Rewarded Interstitial Ad button
        document.getElementById('interstitialBtn').addEventListener('click', () => {
            const btn = document.getElementById('interstitialBtn');
            btn.disabled = true;
            btn.textContent = 'লোড হচ্ছে...';

            show_10539995({ type: 'end' })  // default 'end' = Rewarded Interstitial
                .then(result => {
                    if (result.reward_event_type === 'valued') {
                        points += 100;
                        updatePoints();
                        Telegram.WebApp.HapticFeedback.notificationOccurred('success');
                        alert('অভিনন্দন! আপনি ১০০ পয়েন্ট পেয়েছেন!');
                    } else {
                        alert('অ্যাড দেখানো হয়েছে, কিন্তু এবার রিওয়ার্ড হয়নি।');
                    }
                })
                .catch(err => {
                    alert('অ্যাড লোড হয়নি: ' + (err.message || 'চেষ্টা করুন পরে'));
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.textContent = 'ইন্টারস্টিশিয়াল অ্যাড দেখে ১০০ পয়েন্ট নিন';
                });
        });

        // Rewarded Popup Ad button
        document.getElementById('popupBtn').addEventListener('click', () => {
            const btn = document.getElementById('popupBtn');
            btn.disabled = true;
            btn.textContent = 'খোলা হচ্ছে...';

            show_10539995({ type: 'pop' })  // 'pop' = Rewarded Popup
                .then(result => {
                    if (result.reward_event_type === 'valued') {
                        points += 100;
                        updatePoints();
                        Telegram.WebApp.HapticFeedback.notificationOccurred('success');
                        alert('অভিনন্দন! আপনি ১০০ পয়েন্ট পেয়েছেন!');
                    } else {
                        alert('পপআপ খোলা হয়েছে, কিন্তু এবার রিওয়ার্ড হয়নি।');
                    }
                })
                .catch(err => {
                    alert('পপআপ খুলতে সমস্যা: ' + (err.message || 'আবার চেষ্টা করুন'));
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.textContent = 'পপআপ অ্যাড খুলে ১০০ পয়েন্ট নিন';
                });
        });
    </script>
</body>
</html>
